            .info-tooltip-v2-trigger > #tooltip-icon-wrapper:hover {
                filter: invert(100%);
            }

            .theme-dark .info-tooltip-v2-trigger > #tooltip-icon-wrapper {
                filter: invert(100%);
            }

            .theme-dark .info-tooltip-v2-trigger > #tooltip-icon-wrapper:hover {
                filter: none;
            }

            .info-tooltip-v2 {
                margin: 0;
                padding: 0;
                z-index: 10000;
            }

            .info-tooltip-v2 > .tooltip-arrow {
                display: none;
            }

            .info-tooltip-v2 > .tooltip-inner {
                padding: 0.75rem;
                font-size: 13px;
                font-weight: 500;
            }

            /* No width here on purpose: .tooltip-inner's min-width sizes the card. */
            .info-tooltip-v2 > .tooltip-inner [data-testid="model-info-card"] {
                background: transparent !important;
                border: 0 !important;
                padding: 0 !important;
                min-width: 0 !important;
                text-align: left;
            }

            .info-tooltip-v2 > .tooltip-inner [data-testid="model-info-card"] .justify-between > div {
                white-space: nowrap;
            }

            .info-tooltip-v2 .title-text {
                color: var(--Tooltips-text);
                font-size: 16px;
                line-height: 16px;
                letter-spacing: 0.4px
            }

            .theme-dark .info-tooltip-v2 .title-text {
                color: var(--Tooltips-text);
            }

            .info-tooltip-v2 .small-text {
                color: var(--text-secondary);
                font-size: 12px;
                line-height: 16px;
                letter-spacing: 0.4px;
                font-weight: 400;
            }

            .info-tooltip-v2 .normal-text {
                color: var(--text-secondary);
                font-size: 14px;
                line-height: 16px;
                letter-spacing: 0.4px;
                font-weight: 400;
            }

            .theme-dark .info-tooltip-v2 .normal-text {
                color: var(--text-secondary);
            }

            .info-tooltip-v2 .tag {
                padding: 3px 7px 3px 7px;
            }

            .info-tooltip-v2 .green-tag {
                background-color: var(--function-success-tsp) !important;
                color: var(--function-success);
            }
            .info-tooltip-v2 .red-tag {
                background-color: var(--function-error-tsp) !important;
                color: var(--function-error);
            }
            .info-tooltip-v2 .yellow-tag {
                background-color: var(--function-warning-tsp) !important;
                color: var(--function-warning);
            }

            .info-tooltip-v2 .grey-tag {
                background-color: var(--fill-tsp-gray-main) !important;
                color: var(--text-tertiary) !important;
            }

            .info-tooltip-v2 .highlighted-row {
                background-color: var(--fill-tsp-gray-main)
            }

            .theme-dark .info-tooltip-v2 .highlighted-row {
                background-color: var(--fill-tsp-gray-main)
            }

            .info-tooltip-v2 .text-null {
                color: var(--text-disable)
            }

            .theme-dark .info-tooltip-v2 .text-null {
                color: var(--text-disable)
            }

            .info-tooltip-v2 {
                backdrop-filter: unset  !important;
                border: solid 8px transparent !important;
                border-radius: 0.75rem !important;
                opacity: 1 !important;
            }

            .info-tooltip-v2 > .tooltip-inner {
                background-color: var(--Tooltips-main) !important;
                border: 1px solid var(--Tooltips-border) !important;
                box-shadow: 0 8px 24px var(--shadow-M) !important;
                color: var(--Tooltips-text) !important;
                min-width: 320px !important;
                display: inline-table;
            }

            .theme-dark .info-tooltip-v2 > .tooltip-inner {
                background-color: var(--Tooltips-main) !important;
                color: var(--Tooltips-text) !important;
            }

            .info-tooltip-v2 a.small-text {
                color: var(--text-blue) !important;
            }
